{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["~/second-brain", "~/drive"],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/rclone/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh repo delete*)",
      "Bash(rclone *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["drive *"],
    "filesystem": {
      "allowWrite": ["~/drive/outputs", "~/second-brain"]
    },
    "network": {
      "allowedDomains": [
        "github.com", "*.github.com", "*.githubusercontent.com",
        "registry.npmjs.org", "pypi.org", "files.pythonhosted.org"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "~/.claude/hooks/guard-workspace.sh" }]
      }
    ]
  },
  "statusLine": { "type": "command", "command": "~/.claude/statusline.sh" }
}
